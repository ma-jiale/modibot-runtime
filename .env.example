# LLM provider.
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_MODE=chat
MAX_HISTORY_TURNS=20

# Optional: override the default assistant behavior.
# AGENT_SYSTEM_PROMPT=Reply in concise Simplified Chinese. Do not use Traditional Chinese unless explicitly requested.

# Remote ASR server in the same LAN.
ASR_PROVIDER=remote
ASR_REMOTE_URL=http://192.168.1.100:8000/v1/transcriptions
ASR_REMOTE_TIMEOUT=60
ASR_REMOTE_API_KEY=
ASR_LANGUAGE=zh

# ReSpeaker 2-Mics Pi HAT input for python-sounddevice.
RECORD_DEVICE=seeed2micvoicec
RECORDINGS_DIR=recordings
RECORD_SAMPLE_RATE=16000
RECORD_CHANNELS=1

# TEN VAD for automatic voice turn detection.
TEN_VAD_HOP_SIZE=256
TEN_VAD_START_THRESHOLD=0.50
TEN_VAD_END_THRESHOLD=0.35
VAD_START_MS=300
VAD_SILENCE_MS=900
VAD_MIN_SPEECH_MS=300
VAD_MAX_RECORD_SECONDS=20
VAD_PREROLL_MS=300
