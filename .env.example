# MiniMax Coding/Token Plan
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_MODE=chat

# Optional: alternative MiniMax model.
# MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Optional: override the default assistant behavior.
# AGENT_SYSTEM_PROMPT=Reply in concise Chinese.

# Optional: keep the last N conversation turns.
MAX_HISTORY_TURNS=20

# Optional: text-to-speech.
TTS_ENABLED=false
TTS_PROVIDER=system
TTS_FORMAT=wav
TTS_OUTPUT_DIR=outputs
TTS_AUTOPLAY=false
