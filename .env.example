# MiniMax Coding/Token Plan
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_MODE=chat

# Optional: alternative MiniMax model.
# MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Optional: override the default assistant behavior.
# AGENT_SYSTEM_PROMPT=Reply in concise Chinese.

# Optional: keep the last N conversation turns.
MAX_HISTORY_TURNS=20

# Optional: text-to-speech.
TTS_ENABLED=false
TTS_PROVIDER=system
TTS_FORMAT=wav
TTS_OUTPUT_DIR=outputs
TTS_AUTOPLAY=false
TTS_STREAMING=true
TTS_STREAM_CHUNK_CHARS=60

# Optional: voice input / ASR.
ASR_PROVIDER=faster-whisper
ASR_MODEL_SIZE=base
ASR_DEVICE=gpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
RECORDINGS_DIR=recordings
RECORD_SAMPLE_RATE=16000
RECORD_CHANNELS=1
