# MiniMax Coding/Token Plan
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2.7
MINIMAX_API_MODE=chat

# Optional: alternative MiniMax model.
# MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Optional: override the default assistant behavior.
# AGENT_SYSTEM_PROMPT=Reply in concise Simplified Chinese. Do not use Traditional Chinese unless explicitly requested.

# Optional: keep the last N conversation turns.
MAX_HISTORY_TURNS=20

# Optional: text-to-speech.
TTS_ENABLED=false
TTS_PROVIDER=system
TTS_FORMAT=wav
TTS_OUTPUT_DIR=outputs
TTS_AUTOPLAY=false
TTS_STREAMING=true
TTS_STREAM_CHUNK_CHARS=60

# Optional: voice input / ASR.
ASR_PROVIDER=faster-whisper
ASR_MODEL_SIZE=base
ASR_DEVICE=gpu
ASR_COMPUTE_TYPE=int8
ASR_LANGUAGE=zh
RECORDINGS_DIR=recordings
RECORD_SAMPLE_RATE=16000
RECORD_CHANNELS=1

# Optional: energy VAD for automatic voice turn detection.
VAD_FRAME_MS=30
VAD_START_THRESHOLD=0.018
VAD_END_THRESHOLD=0.012
VAD_SILENCE_MS=900
VAD_MIN_SPEECH_MS=300
VAD_MAX_RECORD_SECONDS=20
VAD_PREROLL_MS=300
